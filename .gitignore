# Rust build output
/target/
**/*.rs.bk
*.pdb

# Runtime state written by the binary at the project root when you
# `cargo run` locally. None of this should be committed:
#  - instantclone.buf:         the disk-backed ring buffer (can be GBs)
#  - instantclone.config.json: per-user settings (may contain stream keys)
/instantclone.buf
/instantclone.config.json

# Editor / IDE
/.vscode/
/.idea/
*.swp
*.swo
*.swn
*~

# OS junk
Thumbs.db
.DS_Store
desktop.ini

# Studio + seeded overlays are generated per-install at runtime (the
# dashboard bakes the built-in presets on first run). Only the shipped
# hand-written overlays are tracked; everything else here is local.
overlays/*.html
!overlays/minimal.html
!overlays/corner.html
!overlays/strip.html
!overlays/custom-template.html
overlays/*/

# Misc
*.log
